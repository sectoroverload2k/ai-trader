# Copy this file to `.env` and fill in your keys, for running LOCALLY.
# (If you run via GitHub Actions instead, set these as repo secrets — see README.)
# NEVER commit the real `.env`.
#
# Get free PAPER-trading keys:
#   1. Sign up at https://alpaca.markets/  (free)
#   2. In the dashboard, switch to "Paper Trading"
#   3. Generate API keys (Trading API) and paste them below.
#
# Paper trading uses fake money — you cannot lose real money with these keys.

ALPACA_API_KEY=your_paper_key_id_here
ALPACA_API_SECRET=your_paper_secret_here

# Must be the PAPER endpoint. The code refuses to place orders against the live URL.
ALPACA_API_ENDPOINT=https://paper-api.alpaca.markets
