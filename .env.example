# Copy this file to `.env` and fill in your keys. NEVER commit the real `.env`.
#
# Get free PAPER-trading keys:
#   1. Sign up at https://alpaca.markets/  (free)
#   2. In the dashboard, switch to "Paper Trading"
#   3. Generate API keys and paste them below.
#
# Paper trading uses fake money — you cannot lose real money with these keys.

ALPACA_API_KEY=your_paper_key_here
ALPACA_SECRET_KEY=your_paper_secret_here

# Leave as the paper endpoint. Do NOT change to the live endpoint until a strategy
# has survived months of paper trading + honest out-of-sample testing.
ALPACA_PAPER=true
